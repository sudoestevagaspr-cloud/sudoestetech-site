# Variáveis de ambiente do site. NUNCA coloque valores reais neste arquivo.
#
# No computador: copie este arquivo para .env.local e preencha (o .env.local
# nunca vai para o GitHub). Na Cloudflare, as variáveis são cadastradas no
# painel, como explica o guia docs/fase-2-site.md.

# Endereço do projeto no Supabase, sem barra no fim.
# Supabase local (npm run db:start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Chave publishable do Supabase (começa com sb_publishable_). Ela aparece no
# navegador de propósito: o RLS do banco é que protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site, sem barra no fim. No computador: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Segredo do aviso do banco para o site (rota /api/revalidar), com pelo menos
# 32 caracteres. O mesmo valor vai no Vault do Supabase. Na Cloudflare, é
# cadastrado como "Secret" (criptografado), nunca como texto comum.
REVALIDAR_SEGREDO=
