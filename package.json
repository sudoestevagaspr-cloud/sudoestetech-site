{
  "name": "sudoestetech-site",
  "private": true,
  "description": "Site de vagas de TI da Sudoeste Tech",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/limpar-cache-de-dados.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:start": "supabase start -x imgproxy,edge-runtime,logflare,vector,realtime,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "docker exec -i supabase_db_sudoestetech-site psql -U postgres -d postgres -X -q -P pager=off < supabase/tests/testes_seguranca.sql",
    "db:lint": "supabase db lint --level warning",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "supabase": "2.122.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
